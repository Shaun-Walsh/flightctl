# Created by Shaun Walsh
# Downloads pre-quantized GGUF model for llama.cpp inference
FROM registry.access.redhat.com/ubi9/python-311:latest as downloader

USER root
RUN pip install huggingface-hub
COPY model-downloader.py .
RUN python model-downloader.py

# Final minimal image with model file only
FROM registry.access.redhat.com/ubi9/ubi-micro:9.4
COPY --from=downloader /models /models
USER 1001
